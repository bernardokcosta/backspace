{
  "name": "veyvox",
  "version": "1.17.2",
  "private": true,
  "description": "Open, self-hosted communication platform — text, voice, and video",
  "license": "AGPL-3.0-only",
  "author": "Jannis Braun",
  "homepage": "https://github.com/bernardokcosta/veyvox",
  "repository": {
    "type": "git",
    "url": "https://github.com/bernardokcosta/veyvox.git"
  },
  "scripts": {
    "dev:server": "pnpm --filter @veyvox/server dev",
    "dev:web": "pnpm --filter @veyvox/web dev",
    "dev": "pnpm --parallel --filter @veyvox/server --filter @veyvox/web dev",
    "build:shared": "pnpm --filter @veyvox/shared build",
    "build:server": "pnpm --filter @veyvox/server build",
    "build:web": "pnpm --filter @veyvox/web build",
    "build": "pnpm --filter @veyvox/shared build && pnpm --filter @veyvox/server build && pnpm --filter @veyvox/web build",
    "typecheck": "pnpm --filter @veyvox/shared build && pnpm -r typecheck && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:suppress": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "test": "pnpm -r test",
    "test:tooling": "node --test \"scripts/*.test.mjs\" \"flatpak/*.test.mjs\" \"packages/desktop/scripts/*.test.mjs\"",
    "dev:desktop": "pnpm --filter @veyvox/desktop dev",
    "build:desktop": "pnpm --filter @veyvox/desktop build",
    "gen-icons": "node scripts/gen-icons.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "dbus-next>xml2js": "^0.6.2",
      "dbus-next>usocket": "-",
      "@vencord/venmic>cmake-js": "-",
      "@rollup/plugin-node-resolve@16.0.3>deepmerge": "-",
      "undici@^6": "^6.28.1",
      "undici@^7": "^7.29.1",
      "fast-uri@^2": "^2.4.7",
      "fast-uri@^3": "^3.1.8",
      "minimatch": "^11.0.5",
      "glob@>=9": "^14.0.3",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^5": "^5.0.12",
      "js-yaml@^4": "^4.3.1",
      "@xmldom/xmldom@^0.8": "^0.8.15",
      "form-data@^4": "^4.0.6",
      "tmp@^0.2": "^0.2.6",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "postcss-selector-parser@^6": "^6.1.3",
      "sharp@^0.35": "^0.35.5",
      "@fastify/busboy@^3": "^3.2.2",
      "proxy-addr@^2": "^2.0.8",
      "http-cache-semantics@^4": "^4.3.0",
      "source-map-js@^1": "^1.2.2",
      "lodash@^4": "^4.18.0",
      "typescript@7.0.2": "5.9.3",
      "esbuild@^0.18": "^0.28.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "@electron/asar@3.4.1": "patches/@electron__asar@3.4.1.patch",
      "dir-compare@4.2.0": "patches/dir-compare@4.2.0.patch",
      "glob@7.2.3": "patches/glob@7.2.3.patch",
      "uiohook-napi@1.5.5": "patches/uiohook-napi@1.5.5.patch",
      "@rollup/plugin-node-resolve@16.0.3": "patches/@rollup__plugin-node-resolve@16.0.3.patch"
    }
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10.0.0"
  }
}
