{
  "name": "@backspace/server",
  "version": "1.14.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Jannis Braun",
  "type": "module",
  "scripts": {
    "dev": "cross-env PORT=3005 tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:federation-identity": "vitest run test/federation-identity-deletion.test.ts",
    "test:federation-e2e": "vitest run federation-e2e",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@backspace/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
