{
  // Type-checks all native e2e suites and shared helpers, which the
  // main tsconfig does not cover (it includes only `src/**/*`, because that is
  // what `pnpm build` emits). Run via `pnpm --filter @veyvox/server typecheck:e2e`.
  //
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "test/helpers/**/*",
    "test/setup-env.ts",
    "test/*.test.ts"
  ]
}
